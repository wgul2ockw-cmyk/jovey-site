                                  "maxLength": 160
                                },
                                "detail": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2000
                                }
                              },
                              "required": [
                                "title",
                                "detail"
                              ],
                              "additionalProperties": false
                            },
                            "maxItems": 3,
                            "minItems": 0
                          }
                        },
                        "required": [
                          "title",
                          "mission",
                          "pillars"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "streams": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^(?!(?:constructor|prototype)$)[a-z][a-z0-9-]{0,39}$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "kind": {
                          "enum": [
                            "strain",
                            "reactor",
                            "extract",
                            "powder",
                            "market",
                            "factory",
                            "pedagogy",
                            "teachers",
                            "kitchen",
                            "erp",
                            "campus",
                            "facility"
                          ]
                        },
                        "stages": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          },
                          "maxItems": 6,
                          "minItems": 0
                        },
                        "completedStages": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 6
                        },
                        "progressKnown": {
                          "type": "boolean"
                        },
                        "next": {
                          "anyOf": [
                            {
                              "type": "string",
