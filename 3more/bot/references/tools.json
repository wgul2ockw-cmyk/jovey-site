    {
      "name": "create_project",
      "description": "Create a personal or team project, optionally with a 3D roadmap. Missing vision, next step, dates and owners remain unknown. Reuse the same projectId and updateId for retries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^(?!(?:constructor|prototype)$)[a-z][a-z0-9-]{0,39}$"
          },
          "updateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "enum": [
              "personal",
              "team"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "roadmap": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "goal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "isMock": {
                    "type": "boolean"
                  },
                  "theme": {
                    "enum": [
                      "industry",
                      "education",
                      "general"
                    ]
                  },
                  "progressKnown": {
                    "type": "boolean"
                  },
                  "vision": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          },
                          "mission": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
