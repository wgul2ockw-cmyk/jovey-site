                              "maxLength": 2000
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "goal": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "dependsOn": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^(?!(?:constructor|prototype)$)[a-z][a-z0-9-]{0,39}$"
                          },
                          "maxItems": 5,
                          "minItems": 0,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "kind",
                        "stages",
                        "completedStages",
                        "next",
                        "goal",
                        "dependsOn"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 6,
                    "minItems": 1
                  }
                },
                "required": [
                  "goal",
                  "isMock",
                  "streams"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "isPlaceholder": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "role",
                "isPlaceholder"
              ],
              "additionalProperties": false
            },
            "maxItems": 8,
            "minItems": 0
          }
        },
        "required": [
          "projectId",
          "updateId",
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true
      }
